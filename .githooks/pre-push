#!/bin/sh
# Refuse to push commits that contain a credential.
#
# GitHub push protection is unavailable on a private repo without Secret Protection
# licensing, so this is the last local gate: once a push succeeds the secret is in
# GitHub's object store and only rotation helps. pre-commit alone does not cover this —
# `--no-verify`, `git commit --amend`, `git rebase`, `git cherry-pick`, and commits made
# before gitleaks was installed all create commits the pre-commit hook never saw.
#
# Fail-closed for the same reason as pre-commit: no scanner means no push.
set -eu

if [ "${HARNESS2_SKIP_SECRET_SCAN:-}" = "1" ]; then
  echo "pre-push: secret scan SKIPPED via HARNESS2_SKIP_SECRET_SCAN=1" >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed; refusing to push unscanned commits." >&2
  echo "  install: brew install gitleaks" >&2
  exit 1
fi

if ! gitleaks git --help >/dev/null 2>&1; then
  echo "pre-push: gitleaks $(gitleaks version 2>/dev/null || echo '(unknown version)') is too old; need v8.19 or newer." >&2
  echo "  upgrade: brew upgrade gitleaks" >&2
  exit 1
fi

blocked=0

# A ref that is all zeros is a deleted branch on one side of the line. Matching on the
# all-zero pattern rather than a fixed 40 characters keeps this working in a SHA-256
# repository, where an oid is 64 hex digits.
is_all_zero() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# stdin is one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _local_ref local_oid _remote_ref remote_oid; do
  # A zero local sha on delete pushes no objects at all.
  if is_all_zero "$local_oid"; then
    continue
  fi

  # A remote oid we never fetched (force-pushing over someone else's commit) is not a
  # commit this clone can diff against, and `gitleaks` exits 0 when git rejects a range —
  # it scans nothing and reports clean. Fall back to "everything not already on a remote"
  # so an invalid range can never turn into a silent pass.
  if is_all_zero "$remote_oid" || ! git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
    range="$local_oid --not --remotes"
  else
    range="$remote_oid..$local_oid"
  fi

  # Belt and braces: refuse to trust a clean result from a range git cannot resolve.
  # shellcheck disable=SC2086  # word splitting of the range is intended
  if ! git rev-list $range -- >/dev/null 2>&1; then
    range="$local_oid --not --remotes"
  fi

  # Nothing to scan is not a failure: pushing an already-known commit under a new ref
  # has no new objects.
  # shellcheck disable=SC2086
  if [ -z "$(git rev-list $range -- 2>/dev/null)" ]; then
    echo "pre-push: no new commits, nothing to scan" >&2
    continue
  fi

  echo "pre-push: scanning ${range}" >&2
  if ! gitleaks git --config "$root/.gitleaks.toml" --log-opts="$range" --redact --no-banner .; then
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: BLOCKED - outgoing commits contain something that looks like a credential." >&2
  echo "  rotate the key if it was real, then rewrite the commits before pushing:" >&2
  echo "  git rebase -i <base>   (or: git reset --soft <base>) and drop the file." >&2
  exit 1
fi
