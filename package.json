{
  "name": "cline-harness2",
  "version": "1.0.0",
  "description": "Faithful TypeScript port of Google Research Harness^2 (arXiv:2610.14224) with T4 context management (arXiv:2609.20804) on top of @cline/sdk",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "cli": "node bin/harness2.mjs",
    "oracle:live": "HARNESS2_LIVE_ORACLE=on node --import tsx --test test/oracle-live.test.ts",
    "spike:sdk": "node --import tsx spikes/sdk.ts",
    "verify:e2e": "node --import tsx scripts/verify-e2e.ts",
    "mcp": "node bin/harness2-mcp.mjs"
  },
  "bin": {
    "harness2": "bin/harness2.mjs",
    "harness2-mcp": "bin/harness2-mcp.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "@cline/sdk": "^0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
